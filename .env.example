# Opcjonalne nadpisanie konfiguracji Supabase (Vite, prefiks PUBLIC_).
# Jeśli puste, używane są wartości domyślne z src/lib/supabase.js.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile — klucz witryny (site key). Jeśli puste, CAPTCHA jest wyłączona.
# Secret key ustaw w Supabase: Authentication → Attack Protection → Enable CAPTCHA.
PUBLIC_TURNSTILE_SITE_KEY=
