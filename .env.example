# Opcjonalne nadpisanie konfiguracji Supabase (Vite, prefiks PUBLIC_).
# Jeśli puste, używane są wartości domyślne z src/lib/supabase.js.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile — klucz witryny (site key). Jeśli puste, CAPTCHA jest wyłączona.
# Secret key ustaw w Supabase: Authentication → Attack Protection → Enable CAPTCHA.
PUBLIC_TURNSTILE_SITE_KEY=

# GUS BIR 1.1 — klucz API REGON (produkcyjny z api.stat.gov.pl/Home/RegonApi).
# Sekret serwerowy — bez przedrostka PUBLIC_/VITE_. Jeśli puste, endpoint
# /api/regon korzysta z bezpłatnego Wykazu podatników VAT (MF) po NIP.
GUS_API_KEY=
